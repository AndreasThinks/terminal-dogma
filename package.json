{
  "name": "nerv-watchface",
  "author": "Andreas Varotsis",
  "version": "1.0.15",
  "description": "Evangelion/NERV-inspired Pebble Time 2 watchface with configurable clock format, bottom modules, accent color, Celsius/Fahrenheit weather, and a configurable SYNC rail. SYNC can show phone/weather data freshness, steps toward 10k, battery level, or a fixed diagnostic state.",
  "keywords": ["pebble-app", "watchface", "nerv"],
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreasThinks/pebble-watchface.git"
  },
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "NERV Watchface",
    "uuid": "44201a31-161f-4e94-ad74-24429abe073e",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": ["configurable", "location"],
    "targetPlatforms": ["emery"],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "CLOCK_FORMAT",
      "BOTTOM_LAYOUT",
      "ACCENT_COLOR",
      "TEMP_UNIT",
      "SYNC_SOURCE",
      "TEMPERATURE",
      "REQUEST_WEATHER"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_NERV_LOGO",
          "file": "images/nerv-logo-red.png"
        }
      ]
    }
  }
}
