{
  "name": "terminal-dogma",
  "author": "Andreas Varotsis",
  "version": "1.0.20",
  "description": "Evangelion/NERV-inspired Pebble Time 2 watchface: MAGI-style HUD with honest health, battery, phone-link and weather states, configurable modules, accent colour, Celsius/Fahrenheit weather, a configurable SYNC rail, optional MAGI/system-boot transitions (Off/Subtle/Full), and a shake-to-show heart-rate graph by default, with an optional forecast.",
  "keywords": ["pebble-app", "watchface", "nerv"],
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreasThinks/pebble-watchface.git"
  },
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Terminal Dogma",
    "uuid": "44201a31-161f-4e94-ad74-24429abe073e",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": ["configurable", "location"],
    "targetPlatforms": ["emery"],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "CLOCK_FORMAT",
      "BOTTOM_LAYOUT",
      "ACCENT_COLOR",
      "TEMP_UNIT",
      "SYNC_SOURCE",
      "TEMPERATURE",
      "REQUEST_WEATHER",
      "ANIMATION",
      "WEATHER_TIME",
      "REQUEST_SETTINGS",
      "FORECAST_START",
      "FORECAST_TEMPS",
      "FORECAST_RAIN",
      "FORECAST_CODES",
      "SHAKE_SCREEN",
      "SHAKE_FX"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_NERV_LOGO",
          "file": "images/nerv-logo-red.png"
        }
      ]
    }
  }
}
