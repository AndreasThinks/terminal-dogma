{
  "name": "nerv-watchface",
  "author": "Andreas Varotsis",
  "version": "1.0.9",
  "keywords": ["pebble-app", "watchface", "nerv"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "NERV Watchface",
    "uuid": "44201a31-161f-4e94-ad74-24429abe073e",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "capabilities": ["configurable", "location"],
    "targetPlatforms": ["emery"],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "CLOCK_FORMAT",
      "CHEVRON_SOURCE",
      "BOTTOM_LAYOUT",
      "ACCENT_COLOR",
      "TEMPERATURE",
      "CONDITIONS",
      "WEATHER_ICON",
      "REQUEST_WEATHER"
    ],
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_NERV_LOGO",
          "file": "images/nerv-logo-red.png"
        }
      ]
    }
  }
}
